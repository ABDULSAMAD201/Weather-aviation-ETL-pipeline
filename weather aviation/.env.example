# SADIS OPMET API Configuration
# Replace these values with your actual credentials
SADIS_CLIENT_ID=your_client_id_here
SADIS_CLIENT_SECRET=your_client_secret_here
SADIS_TOKEN_URL=https://api-manager.api-management.metoffice.cloud/oauth2/token
SADIS_BASE_URL=https://gateway.api-management.metoffice.cloud/sadis-opmet/1

# Firebase Configuration (automatically set by Firebase Functions)
# No need to manually configure these
FIREBASE_CONFIG=auto

# API Authentication (for your app to call the API)
# Change this to a secure random string
API_AUTH_KEY=change_this_to_secure_key
